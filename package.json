{
  "name": "vigil",
  "version": "0.2.0",
  "private": true,
  "description": "Vigil – defensives Sicherheits-Audit für eigene Projekte, Webseiten, Server und Container.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "test": "node test/run.js",
    "make-icon": "node tools/make-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "bench": "node tools/bench.js",
    "e2e": "node test/e2e.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.7",
    "socks": "^2.8.10",
    "undici": "^6.21.1",
    "zod": "^3.23.8"
  },
  "build": {
    "appId": "com.passimoritz.vigil",
    "productName": "Vigil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "bench/vulnerable-app/**/*",
      "package.json",
      "!test/**",
      "!tools/**",
      "!dist/**",
      "!build/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "legalTrademarks": "Vigil",
      "signtoolOptions": {
        "publisherName": "Passimoritz"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vigil",
      "uninstallDisplayName": "Vigil ${version}",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "build/license.txt",
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ],
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Vigil-Setup-${version}.${ext}",
      "menuCategory": false
    },
    "copyright": "Copyright © 2026 Passimoritz",
    "portable": {
      "artifactName": "Vigil-Portable-${version}.${ext}",
      "unicode": true
    }
  },
  "author": {
    "name": "Passimoritz",
    "email": "passimoritz@gmail.com"
  }
}
