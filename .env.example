# Vigil - API-Schluessel (optional).
# Du kannst Schluessel entweder hier eintragen ODER direkt in den Einstellungen der App.
# Diese Datei NICHT ins Git committen (steht in .gitignore).

# Anthropic / Claude
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Generischer OpenAI-kompatibler Anbieter (Mistral, DeepSeek, Groq, LM Studio, ...)
# Beispiel Basis-URL: https://api.mistral.ai/v1  oder  http://localhost:1234/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Ollama laeuft lokal und braucht keinen Schluessel.
OLLAMA_BASE_URL=http://localhost:11434
