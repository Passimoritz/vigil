<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath-Artefakt-Konfiguration "app": signiert die ungepackte App (GitHub-Artefakt vigil-unpacked, als ZIP) -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Vigil.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file-set>
      <include path="*.dll" min-matches="0" max-matches="unbounded" />
      <include path="resources/**/*.exe" min-matches="0" max-matches="unbounded" />
      <include path="resources/**/*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
