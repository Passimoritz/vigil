<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath-Artefakt-Konfiguration "installers": signiert Installer und portable Version (GitHub-Artefakt vigil-installers, als ZIP) -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Vigil-Setup-*.exe" />
      <include path="Vigil-Portable-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
